# Dependencies
node_modules/

# Build artifacts (M0 runs from source via tsx; build faces come later)
lib/
dist/
*.tsbuildinfo

# Runtime data
.sessions/
.clue/
.env

# Dogfood/web runtime state (M8 workspace binding; session dirs from `clue web`)
.dogfood-home/
.dsh-home/
.clue-sessions/

# Playwright browser binaries (sandbox-local download; user machines use the
# playwright default cache or `npx playwright install`)
.ms-playwright/

# Logs & OS cruft
*.log
.DS_Store
Thumbs.db
*Zone.Identifier

# 评测数据与报告(单独存放,可整体删除)
evals/datasets/
evals/runs/
evals/cache/

# 文档与个人文件不进仓库(本地另存:../clue-harness-archive-noncode/)
docs/
*.docx
*.pdf

# 演示脚本的截图落点(文档不进仓库,截图同样不进)
/docs/
