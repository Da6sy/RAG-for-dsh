# Dependencies
node_modules/

# Build artifacts (browser halves are built with esbuild)
lib/
dist/
*.tsbuildinfo

# Runtime data
.sessions/
.clue/
.env

# Dogfood/web runtime state (local session dirs; not part of the dsh plugins)
.dogfood-home/
.dsh-home/
.clue-sessions/

# Playwright browser binaries (sandbox-local download; user machines use the
# playwright default cache or `npx playwright install`)
.ms-playwright/

# Logs & OS cruft
*.log
.DS_Store
Thumbs.db
*Zone.Identifier

# Eval runtime cache (not part of the plugin source)
evals/cache/

# 文档与个人文件不进仓库(本地另存:../clue-harness-archive-noncode/)
docs/
*.docx
*.pdf
