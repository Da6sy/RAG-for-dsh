{
  "name": "@clue-harness/ui-skin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The dsh Web appearance plugin: a full-window wallpaper with an adjustable scrim, frosted panels, liquid-glass conversation bubbles, and an Appearance/Background settings page whose values persist through dsh's own settings section. A dsh.client dual-face plugin: the node half declares the ui-clue-skin config schema; the browser half is the esbuild-wrapped lib/client.js module-table bundle.",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./config": "./src/skin-config.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/client.js",
    "lib/client.js.map",
    "src"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-terminal": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@types/react": "~18.3.1",
    "esbuild": "0.28.2",
    "react": "^18.2.0"
  }
}
